# AirTutor Environment Configuration Example
# Copy this file to .env and fill in values as needed.
# Note: For Stages 0-5 before Prompt 6, no API keys are required.

# LLM Provider Configuration (Stage 5+)
# Options: offline (default for development), gemini, openai_compatible
LLM_PROVIDER=offline
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
