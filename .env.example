# AirTutor Environment Configuration Example
# Copy this file to .env and fill in values as needed.
# Note: With zero API keys and no .env file, AirTutor automatically
# operates safely using the OfflineTemplateAdapter.

# LLM Provider Configuration (Stage 5)
# Options: offline (default), gemini, openai_compatible
LLM_PROVIDER=offline

# Model Name
# Gemini: gemini-2.5-flash (or gemini-2.0-flash)
# OpenAI-compatible: gpt-4o-mini, llama3:8b, mistral, etc.
LLM_MODEL=gemini-2.5-flash

# API Key (from environment only - never hard-code or commit)
# For Gemini, GEMINI_API_KEY is also automatically checked
LLM_API_KEY=
GEMINI_API_KEY=

# Base URL (for openai_compatible only, e.g. local Ollama, vLLM, or LM Studio)
# Examples:
#   OpenAI: https://api.openai.com/v1
#   Ollama: http://localhost:11434/v1
#   vLLM:   http://localhost:8000/v1
LLM_BASE_URL=

# Timeout in seconds for LLM network requests before triggering offline fallback
LLM_TIMEOUT=15
